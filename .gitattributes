# Shell scripts and unit files must keep LF endings: CRLF breaks the shebang
# and systemd parsing on Linux, even when they are edited on Windows.
* text=auto eol=lf

tngbackup   text eol=lf
*.sh        text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.1         text eol=lf

*.md        text eol=lf
